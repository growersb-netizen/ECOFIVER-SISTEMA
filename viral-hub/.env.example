# ─────────────────────────────────────────────
#  VIRAL HUB — Variables de entorno
#  Copiar a .env y completar los valores reales
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development           # development | production
SECRET_KEY=cambia-esto-por-una-clave-de-64-chars-aleatoria
JWT_SECRET_KEY=cambia-esto-por-otra-clave-secreta-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Base de datos ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://viralhub:viralpass@db:5432/viralhub
DATABASE_SYNC_URL=postgresql://viralHub:viralpass@db:5432/viralHub

# ── Redis / Celery ────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Storage (Cloudflare R2 o AWS S3) ──────────
STORAGE_BUCKET=viral-hub-media
STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://media.tudominio.com

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Viral Hub

# ── Plataformas sociales ──────────────────────
# Instagram / Facebook (Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/tiktok/callback

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# ── Email (para notificaciones) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@viralHub.io

# ── Encriptación de tokens OAuth ─────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Sentry (observabilidad) ───────────────────
SENTRY_DSN=
