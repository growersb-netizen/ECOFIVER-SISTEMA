# ══════════════════════════════════════════════════════════════════════
# FITNESS BUSINESS OS — Variables de entorno
# Copiá este archivo como .env.local (desarrollo) o configurá en Railway/Vercel
# ══════════════════════════════════════════════════════════════════════

# ── BASE DE DATOS (Railway PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/fitness_os"

# ── JWT ─────────────────────────────────────────────────────────────
# Secreto para firmar tokens. DEBE ser un valor largo y aleatorio en producción.
# Generar con: openssl rand -hex 64
JWT_SECRET="CAMBIA-ESTO-POR-UN-SECRETO-ALEATORIO"
JWT_EXPIRES_IN="7d"

# ── ENTORNO ──────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3001"
LOG_LEVEL="info"

# ── URLS DE LA APLICACIÓN ────────────────────────────────────────────
# Usadas para CORS y links en emails
APP_API_URL="https://fitness-api-production-fff4.up.railway.app"
APP_WEB_URL="https://fitness-os-web.vercel.app"
APP_ADMIN_URL="https://fitness-os-admin.vercel.app"

# ── IDENTIDAD DE LA TIENDA ───────────────────────────────────────────
# Personalizar con el nombre real del negocio
STORE_NAME="Fitness Business OS"
SUPPORT_EMAIL="soporte@fitnessbusiness.com"
FROM_EMAIL="Fitness Business OS <noreply@fitnessbusiness.com>"

# ── MERCADOPAGO ──────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers/es
# Panel > Credenciales > Producción > Access Token
MERCADOPAGO_ACCESS_TOKEN=""
# OPCIONAL: para verificar la firma del webhook (recomendado en producción)
MERCADOPAGO_WEBHOOK_SECRET=""

# ── RESEND (email transaccional) ────────────────────────────────────
# Obtener en: https://resend.com/api-keys
# Plan gratuito: 3000 emails/mes
# IMPORTANTE: verificar dominio en Resend para usar FROM_EMAIL personalizado
# Mientras no esté verificado, usar: onboarding@resend.dev como sender
RESEND_API_KEY=""

# ── CLOUDFLARE R2 (storage ZIPs) ────────────────────────────────────
# Obtener en: https://dash.cloudflare.com > R2 > API Tokens
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="fitness-os"
# URL pública del bucket (opcional, si lo tenés como público)
R2_PUBLIC_URL=""

# ── OPENROUTER (IA) ─────────────────────────────────────────────────
# Obtener en: https://openrouter.ai/keys
# Única fuente de IA en producción (no usar Anthropic directamente)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# ── WHATSAPP CLOUD API ───────────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ── MERCADOLIBRE ─────────────────────────────────────────────────────
# Obtener en: https://developers.mercadolibre.com.ar/
ML_APP_ID=""
ML_APP_SECRET=""
ML_SELLER_ID=""

# ── SANDBOX / TESTING ────────────────────────────────────────────────
# Habilitar el endpoint /orders/:id/simulate-payment
# NO poner en true en producción real
SANDBOX_MODE="false"

# ── ADMIN SETUP ──────────────────────────────────────────────────────
# Secreto para resetear la contraseña del admin via API
ADMIN_RESET_SECRET="CAMBIA-ESTO"

# ──────────────────────────────────────────────────────────────────────
# NEXT.JS (apps/web y apps/admin — configurar en Vercel)
# Estas variables DEBEN empezar con NEXT_PUBLIC_ para ser accesibles
# en el browser. Requieren rebuild completo al cambiarlas en Vercel.
# ──────────────────────────────────────────────────────────────────────

# URL de la API (Railway)
NEXT_PUBLIC_API_URL="https://fitness-api-production-fff4.up.railway.app"

# Slug del tenant (identificador único del negocio)
NEXT_PUBLIC_TENANT_SLUG="fitness-business-os"

# Nombre de la tienda (aparece en navbar, título, emails)
NEXT_PUBLIC_STORE_NAME="Fitness Business OS"
