# ═══════════════════════════════════════════════════
# Eco Módulos & Piscinas — Variables de entorno
# Copiá este archivo como .env y completá los valores
# ═══════════════════════════════════════════════════

# ── Gemini AI ──────────────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini

# ── WhatsApp Meta Cloud API ────────────────────────
# Obtenés estos datos desde: https://developers.facebook.com
# > Tu App > WhatsApp > Configuración de API
WHATSAPP_TOKEN=          # Token de acceso (empieza con EAABx...)
WHATSAPP_PHONE_NUMBER_ID= # ID del número de teléfono (ej: 123456789012345)
WHATSAPP_VERIFY_TOKEN=un_token_de_verificacion_propio

# ── Notificaciones ─────────────────────────────────
NOTIFICATION_NUMBER=549XXXXXXXXXX

# ── App ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
