# Gemini IA
GEMINI_API_KEY=

# CRM EcoFiver (FastAPI en Railway)
# Producción: https://eco-crm-production.up.railway.app
# Local:      http://localhost:8001
CRM_BASE_URL=https://eco-crm-production.up.railway.app
CRM_API_KEY=<misma API_KEY configurada en eco-crm>

# Telegram (canal de control Rodrigo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_RODRIGO=

# WhatsApp Business API Meta
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=eco_modules_verify_2026

# Cloudflare Workers (Ecopost/Renata)
CLOUDFLARE_WORKER_URL=https://eco-agentes.growersb.workers.dev

# Google Drive (backup contenido)
GOOGLE_DRIVE_FOLDER_ID=1tXwe5E9M7R31Q8X-fMhpmn-TgVWPak4W

# Web
PORT=8080
BASE_URL=https://eco-multiagente.up.railway.app

# ── Seguridad (Etapa 0) ───────────────────────────────────────────────────────
# Obligatoria: sin ella los paneles y endpoints protegidos quedan deshabilitados.
ADMIN_PASSWORD=<contraseña fuerte>
# Opcional: clave para integraciones (CRM Control Center → /api/comando, scripts).
MULTIAGENTE_API_KEY=<openssl rand -hex 32>
# App Secret de la app de Meta que entrega el webhook de WhatsApp (si no, se usa META_APP_SECRET).
WA_APP_SECRET=
# off | log | enforce  (empezar en log, pasar a enforce cuando /health/seguridad muestre firmas válidas)
WA_WEBHOOK_SIGNATURE_MODE=log
