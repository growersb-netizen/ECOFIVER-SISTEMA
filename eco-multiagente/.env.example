# Gemini IA
GEMINI_API_KEY=

# CRM EcoFiver (FastAPI en Railway)
# Producción: https://eco-crm-production.up.railway.app
# Local:      http://localhost:8001
CRM_BASE_URL=https://eco-crm-production.up.railway.app
CRM_API_KEY=<misma API_KEY configurada en eco-crm>

# Telegram (canal de control Rodrigo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_RODRIGO=

# WhatsApp Business API Meta
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=eco_modules_verify_2026

# Cloudflare Workers (Ecopost/Renata)
CLOUDFLARE_WORKER_URL=https://eco-agentes.growersb.workers.dev

# Google Drive (backup contenido)
GOOGLE_DRIVE_FOLDER_ID=1tXwe5E9M7R31Q8X-fMhpmn-TgVWPak4W

# Web
PORT=8080
BASE_URL=https://eco-multiagente.up.railway.app

# ── Seguridad (Etapa 0) ───────────────────────────────────────────────────────
# Obligatoria: sin ella los paneles y endpoints protegidos quedan deshabilitados.
ADMIN_PASSWORD=<contraseña fuerte>
# Opcional: clave para integraciones (CRM Control Center → /api/comando, scripts).
MULTIAGENTE_API_KEY=<openssl rand -hex 32>
# App Secret de la app de Meta que entrega el webhook de WhatsApp (si no, se usa META_APP_SECRET).
WA_APP_SECRET=
# off | log | enforce  (empezar en log, pasar a enforce cuando /health/seguridad muestre firmas válidas)
WA_WEBHOOK_SIGNATURE_MODE=log

# ── Observabilidad (Etapa 1) ──────────────────────────────────────────────────
# Informes de Aurora/Tomás/Renata al Telegram de Rodrigo (0 = desactivado)
ETAPA1_INFORMES_TELEGRAM=1
# Límite diario de costo de IA para alertas (USD). No bloquea respuestas.
AI_DAILY_COST_LIMIT_USD=5
# Precios por millón de tokens (entrada, salida) para estimar costo, si el proveedor no lo informa
# AI_PRICES_JSON={"openai/gpt-4o-mini": [0.15, 0.60]}

# ── OpenRouter (único proveedor de IA) ────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Respaldo dentro de OpenRouter si falla el modelo principal
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash
# Transcripción de notas de voz (modelos con entrada de audio)
AUDIO_OPENROUTER_MODELS=google/gemini-2.5-flash,google/gemini-2.0-flash-001
# Modelo por agente: base (igual que antes) | recomendado (según función). Ver docs/ai-company/MODELOS_POR_AGENTE.md
AI_PERFIL_MODELOS=base
# Ajuste fino por agente o rol (JSON). Ej: {"maximo": {"modelo": "anthropic/claude-sonnet-4"}}
# AI_MODELOS_JSON=
