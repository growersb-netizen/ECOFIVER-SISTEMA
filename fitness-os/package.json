{
  "name": "fitness-os",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "pnpm --filter @fitness-os/database studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "r2:upload": "tsx scripts/upload-to-r2.ts",
    "r2:upload:dry": "DRY_RUN=true tsx scripts/upload-to-r2.ts",
    "seed:product-files": "tsx scripts/seed-product-files.ts",
    "seed:product-files:dry": "DRY_RUN=true tsx scripts/seed-product-files.ts",
    "generate:products": "pnpm --filter @fitness-os/database generate:products",
    "bundle-zips": "pnpm --filter @fitness-os/database bundle-zips",
    "bundle-zips:all": "pnpm --filter @fitness-os/database bundle-zips ALL"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
